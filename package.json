{
  "name": "@techpickles/sb",
  "version": "0.4.1",
  "description": "Second Brain CLI for Obsidian vault management",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "sb": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --enable-source-maps --loader ts-node/esm src/index.ts",
    "test": "vitest --run",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "cli",
    "obsidian",
    "second-brain",
    "zettelkasten",
    "pkm"
  ],
  "author": "Josh Nichols <josh@technicalpickles.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technicalpickles/sb.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
